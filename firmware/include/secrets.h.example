#pragma once

// Copy to secrets.h and fill in. secrets.h is gitignored.
//
// The firmware tries visible profiles strongest-first. A profile with a
// username joins as WPA2-Enterprise (PEAP) when the AP advertises it, and
// as WPA2-PSK with the password otherwise. Open networks are a last resort
// and are kept only when they can reach WS_HOST.

struct WifiProfile {
  const char *ssid;
  const char *password;
  const char *username;
};

static const char *WIFI_DEV_PASSWORD = "YOUR_DEV_WIFI_PASSWORD";
static const char *WIFI_ENTERPRISE_USER = "YOUR_USERNAME";
static const char *WIFI_ENTERPRISE_PASSWORD = "YOUR_WIFI_PASSWORD";

static const WifiProfile WIFI_PROFILES[] = {
    {"dev", WIFI_DEV_PASSWORD, nullptr},
    {"CAMPUS_SECURED", WIFI_ENTERPRISE_PASSWORD, WIFI_ENTERPRISE_USER},
    {"GUEST_SECURED", WIFI_ENTERPRISE_PASSWORD, WIFI_ENTERPRISE_USER},
};

static const int WIFI_PROFILE_COUNT =
    (int)(sizeof(WIFI_PROFILES) / sizeof(WIFI_PROFILES[0]));

// Desk LAN: host = operator PC IP, port 8080, TLS off (begin).
// Production: host = your domain, port 443, TLS on (beginSSL).
static const char *WS_HOST = "192.168.1.10";
static const int WS_PORT = 8080;
static const bool WS_USE_SSL = false;

// Must match DEVICE_TOKEN on the server (.env), min 16 chars.
static const char *DEVICE_TOKEN = "change-me-device-token";

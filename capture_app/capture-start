#!/usr/bin/env bash
# capture-start — launcher for ewrp-gio (local codename).

set -uo pipefail

PROC="ewrp-gio"
LEGACY_PROCS=(xdp-screencast capture-app)
NOTIFY_APP="goa-daemon"
HIDE_INDICATOR_HINT=""

STATE_DIR="${HOME}/.local/state/${PROC}"
PID_FILE="${STATE_DIR}/${PROC}.pid"
for legacy_dir in xdp-screencast capture-app; do
    if [ ! -f "${PID_FILE}" ] && [ -f "${HOME}/.local/state/${legacy_dir}/capture-app.pid" ]; then
        PID_FILE="${HOME}/.local/state/${legacy_dir}/capture-app.pid"
    elif [ ! -f "${PID_FILE}" ] && [ -f "${HOME}/.local/state/${legacy_dir}/${legacy_dir}.pid" ]; then
        PID_FILE="${HOME}/.local/state/${legacy_dir}/${legacy_dir}.pid"
    fi
done
LOG_FILE="${STATE_DIR}/start.log"
LOCK_FILE="${STATE_DIR}/shortcut.lock"
for legacy_dir in xdp-screencast capture-app; do
    if [ ! -d "${STATE_DIR}" ] && [ -d "${HOME}/.local/state/${legacy_dir}" ]; then
        LOCK_FILE="${HOME}/.local/state/${legacy_dir}/shortcut.lock"
    fi
done

mkdir -p "${STATE_DIR}"
chmod 0700 "${STATE_DIR}" 2>/dev/null || true

ts() { date '+%Y-%m-%d %H:%M:%S.%3N'; }
log_msg() { printf '[%s] [start] %s\n' "$(ts)" "$1" >> "${LOG_FILE}"; }
notify_user() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -u "$1" -a "${NOTIFY_APP}" "$2" "$3" >/dev/null 2>&1 || true
}

resolve_sync_indicator_script() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for candidate in \
        "${script_dir}/sync-gnome-hide-indicator.sh" \
        "${HOME}/Projects/remote_operator_console/capture_app/sync-gnome-hide-indicator.sh"; do
        if [ -f "${candidate}" ]; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

sync_hide_indicator() {
    local sync_script hint_rc hint_out
    sync_script="$(resolve_sync_indicator_script)" || return 0
    hint_out="$(bash "${sync_script}" 2>&1)" || hint_rc=$?
    hint_rc=${hint_rc:-0}
    log_msg "hide-indicator: ${hint_out}"
    if [ "${hint_rc}" -eq 2 ]; then
        HIDE_INDICATOR_HINT="${hint_out}"
    fi
}

live_pids() {
    local out=""
    out="$(pgrep -x -u "$(id -u)" "${PROC}" 2>/dev/null || true)"
    if [ -n "${out}" ]; then printf '%s' "${out}"; return; fi
    for leg in "${LEGACY_PROCS[@]}"; do
        out="$(pgrep -x -u "$(id -u)" "${leg}" 2>/dev/null || true)"
        if [ -n "${out}" ]; then printf '%s' "${out}"; return; fi
    done
}

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PIPEWIRE_REMOTE="${PIPEWIRE_REMOTE:-pipewire-0}"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

BIN=""
for candidate in \
    "${HOME}/Projects/remote_operator_console/capture_app/${PROC}" \
    "${HOME}/.local/bin/${PROC}" \
    "/usr/local/bin/${PROC}"; do
    [ -x "${candidate}" ] && BIN="${candidate}" && break
done
if [ -z "${BIN}" ]; then
    for leg in "${LEGACY_PROCS[@]}"; do
        for candidate in \
            "${HOME}/Projects/remote_operator_console/capture_app/${leg}" \
            "${HOME}/.local/bin/${leg}" \
            "/usr/local/bin/${leg}"; do
            [ -x "${candidate}" ] && BIN="${candidate}" && break 2
        done
    done
fi
if [ -z "${BIN}" ] && command -v "${PROC}" >/dev/null 2>&1; then
    BIN="$(command -v "${PROC}")"
fi
if [ -z "${BIN}" ]; then
    msg="ERROR: ${PROC} not found"
    log_msg "${msg}"
    notify_user critical "Service unavailable" "${msg}"
    echo "${msg}" >&2
    exit 1
fi

exec 9>"${LOCK_FILE}"
if ! flock -w 15 9; then
    msg="ERROR: lock timeout"
    log_msg "${msg}"
    notify_user critical "Service unavailable" "${msg}"
    echo "${msg}" >&2
    exit 1
fi

LIVE_PIDS="$(live_pids)"
if [ -n "${LIVE_PIDS}" ]; then
    first_pid="$(printf '%s\n' "${LIVE_PIDS}" | head -n1)"
    msg="already running (PID ${first_pid})"
    log_msg "No-op: ${msg}"
    echo "${msg}"
    exit 0
fi

[ -f "${PID_FILE}" ] && rm -f "${PID_FILE}"

CONSOLE_ENV_FILE="${HOME}/Projects/remote_operator_console/console/.env"
if [ -z "${CAPTURE_TOKEN:-}" ] && [ -f "${CONSOLE_ENV_FILE}" ]; then
    CAPTURE_TOKEN="$(grep -E '^CAPTURE_TOKEN=' "${CONSOLE_ENV_FILE}" | head -n1 | cut -d= -f2- | tr -d '[:space:]' || true)"
    [ -z "${CAPTURE_TOKEN}" ] && CAPTURE_TOKEN="$(grep -E '^BRIDGE_TOKEN=' "${CONSOLE_ENV_FILE}" | head -n1 | cut -d= -f2- | tr -d '[:space:]' || true)"
fi
CAPTURE_WHIP_URL="${CAPTURE_WHIP_URL:-https://mediarelay.sahilpatel.online/desk/whip}"
CAPTURE_CONSOLE_URL="${CAPTURE_CONSOLE_URL:-https://webrelay.sahilpatel.online}"
EXTRA_ARGS=(--whip-url "${CAPTURE_WHIP_URL}")
if [ -n "${CAPTURE_TOKEN:-}" ] && [ -n "${CAPTURE_CONSOLE_URL:-}" ]; then
    EXTRA_ARGS+=(--console-url "${CAPTURE_CONSOLE_URL}" --capture-token "${CAPTURE_TOKEN}")
fi

sync_hide_indicator

log_msg "Invoking: ${BIN} start"
START_OUT="$("${BIN}" start "${EXTRA_ARGS[@]}" "$@" 9>&- 2>&1)"
START_RC=$?
while IFS= read -r line; do [ -n "${line}" ] && log_msg "output: ${line}"; done <<< "${START_OUT}"

if [ "${START_RC}" -ne 0 ]; then
    msg="start failed (exit ${START_RC})"
    log_msg "ERROR: ${msg}"
    notify_user critical "Service unavailable" "See ${LOG_FILE}"
    echo "${START_OUT}" >&2
    exit 1
fi

NEW_PID="$(live_pids | head -n1 || true)"
if [ -z "${NEW_PID}" ]; then
    msg="ERROR: no live process after start"
    log_msg "${msg}"
    notify_user critical "Service unavailable" "${msg}"
    echo "${msg}" >&2
    exit 1
fi

msg="${PROC} started (PID ${NEW_PID})"
log_msg "SUCCESS: ${msg}"
echo "${msg}"
if [ -n "${HIDE_INDICATOR_HINT}" ]; then
    echo "Note (top-bar orange cast pill): ${HIDE_INDICATOR_HINT}"
fi
exit 0

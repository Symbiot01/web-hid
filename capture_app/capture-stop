#!/usr/bin/env bash
# capture-stop — stop ewrp-gio (local codename).

set -uo pipefail

PROC="ewrp-gio"
LEGACY_PROCS=(xdp-screencast capture-app)
NOTIFY_APP="goa-daemon"

STATE_DIR="${HOME}/.local/state/${PROC}"
PID_FILE="${STATE_DIR}/${PROC}.pid"
for legacy_dir in xdp-screencast capture-app; do
    if [ ! -f "${PID_FILE}" ] && [ -f "${HOME}/.local/state/${legacy_dir}/capture-app.pid" ]; then
        PID_FILE="${HOME}/.local/state/${legacy_dir}/capture-app.pid"
    elif [ ! -f "${PID_FILE}" ] && [ -f "${HOME}/.local/state/${legacy_dir}/${legacy_dir}.pid" ]; then
        PID_FILE="${HOME}/.local/state/${legacy_dir}/${legacy_dir}.pid"
    fi
done
LOG_FILE="${STATE_DIR}/stop.log"
LOCK_FILE="${STATE_DIR}/shortcut.lock"
for legacy_dir in xdp-screencast capture-app; do
    if [ ! -d "${STATE_DIR}" ] && [ -d "${HOME}/.local/state/${legacy_dir}" ]; then
        LOCK_FILE="${HOME}/.local/state/${legacy_dir}/shortcut.lock"
    fi
done

mkdir -p "${STATE_DIR}"
chmod 0700 "${STATE_DIR}" 2>/dev/null || true

ts() { date '+%Y-%m-%d %H:%M:%S.%3N'; }
log_msg() { printf '[%s] [stop] %s\n' "$(ts)" "$1" >> "${LOG_FILE}"; }
notify_user() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -u "$1" -a "${NOTIFY_APP}" "$2" "$3" >/dev/null 2>&1 || true
}

live_pids() {
    local out=""
    out="$(pgrep -x -u "$(id -u)" "${PROC}" 2>/dev/null || true)"
    if [ -n "${out}" ]; then printf '%s' "${out}"; return; fi
    for leg in "${LEGACY_PROCS[@]}"; do
        out="$(pgrep -x -u "$(id -u)" "${leg}" 2>/dev/null || true)"
        if [ -n "${out}" ]; then printf '%s' "${out}"; return; fi
    done
}

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PIPEWIRE_REMOTE="${PIPEWIRE_REMOTE:-pipewire-0}"

BIN=""
for candidate in \
    "${HOME}/Projects/remote_operator_console/capture_app/${PROC}" \
    "${HOME}/.local/bin/${PROC}" \
    "/usr/local/bin/${PROC}"; do
    [ -x "${candidate}" ] && BIN="${candidate}" && break
done
if [ -z "${BIN}" ]; then
    for leg in "${LEGACY_PROCS[@]}"; do
        for candidate in \
            "${HOME}/Projects/remote_operator_console/capture_app/${leg}" \
            "${HOME}/.local/bin/${leg}" \
            "/usr/local/bin/${leg}"; do
            [ -x "${candidate}" ] && BIN="${candidate}" && break 2
        done
    done
fi
if [ -z "${BIN}" ] && command -v "${PROC}" >/dev/null 2>&1; then
    BIN="$(command -v "${PROC}")"
fi
if [ -z "${BIN}" ]; then
    msg="ERROR: ${PROC} not found"
    log_msg "${msg}"
    echo "${msg}" >&2
    exit 1
fi

exec 9>"${LOCK_FILE}"
if ! flock -w 15 9; then
    msg="ERROR: lock timeout"
    log_msg "${msg}"
    echo "${msg}" >&2
    exit 1
fi

LIVE_PIDS="$(live_pids)"
if [ -z "${LIVE_PIDS}" ]; then
    [ -f "${PID_FILE}" ] && rm -f "${PID_FILE}"
    msg="${PROC} is not running"
    log_msg "No-op: ${msg}"
    echo "${msg}"
    exit 0
fi

first_pid="$(printf '%s\n' "${LIVE_PIDS}" | head -n1)"
log_msg "Stopping PID ${first_pid} via ${BIN} stop"
STOP_OUT="$("${BIN}" stop 9>&- 2>&1)"
STOP_RC=$?
while IFS= read -r line; do [ -n "${line}" ] && log_msg "output: ${line}"; done <<< "${STOP_OUT}"

for _ in $(seq 1 30); do
    [ -z "$(live_pids)" ] && break
    sleep 0.1
done

if [ -n "$(live_pids)" ]; then
    msg="ERROR: still running after stop (rc=${STOP_RC})"
    log_msg "${msg}"
    echo "${msg}" >&2
    exit 1
fi

rm -f "${PID_FILE}" 2>/dev/null || true
msg="${PROC} stopped (was PID ${first_pid})"
log_msg "SUCCESS: ${msg}"
echo "${msg}"
exit 0

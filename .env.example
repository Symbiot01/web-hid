# Required. Shared UI gate password (min 16 characters). Never commit real values.
GATE_PASSWORD=

# Required. Random secret for signing session cookies (min 32 characters).
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Server bind (default 8080 for LAN ESP32 compatibility)
PORT=8080
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Set to 1 behind Coolify / reverse proxy so client IPs are correct for rate limits
TRUST_PROXY=0

# Legacy unauthenticated ESP32 WebSocket on path "/".
# Required for current firmware (ws://LAN:8080/).
# In NODE_ENV=production the process refuses to start unless this is exactly "true".
# Do NOT enable on a public Coolify host until firmware uses DEVICE_TOKEN + /ws/device.
ALLOW_LEGACY_DEVICE=true

# Optional future path (not required for compat-first local use)
# DEVICE_TOKEN=

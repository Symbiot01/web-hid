# WebSocket path on the operator console. Token is added as ?token=
WS_URL=wss://webrelay.sahilpatel.online/ws/device

# Must match DEVICE_TOKEN on the console. Never printed or written to hid_test.txt by the simulator itself.
DEVICE_TOKEN=YOUR_DEVICE_TOKEN

# Where paste text and decoded live keystrokes are appended.
OUTPUT_FILE=./hid_test.txt

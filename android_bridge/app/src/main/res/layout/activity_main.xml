<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LookCam Bridge"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Stopped"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pillHotspot"
            style="@style/Pill" />

        <TextView
            android:id="@+id/pillCamera"
            style="@style/Pill" />

        <TextView
            android:id="@+id/pillConsole"
            style="@style/Pill" />

        <TextView
            android:id="@+id/pillVideo"
            style="@style/Pill" />

        <TextView
            android:id="@+id/counters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/reconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reconnect" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Console URL"
                android:inputType="textUri"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/tokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bridge token"
                android:inputType="textPassword"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/deviceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Camera id"
                android:inputType="text"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Optional camera IP"
                android:inputType="text"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted" />

            <CheckBox
                android:id="@+id/autoStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start again after reboot"
                android:textColor="@color/ink" />
        </LinearLayout>

        <Button
            android:id="@+id/backgroundButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/allow_background" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_debug" />
    </LinearLayout>
</ScrollView>

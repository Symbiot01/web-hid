<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LookCamBridge" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/ok</item>
        <item name="colorAccent">@color/ok</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@color/card</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/ok</item>
        <item name="android:textColor">#062017</item>
    </style>

    <style name="RowButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Field" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="BitCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>

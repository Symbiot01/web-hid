<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LookCamBridge" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/ok</item>
        <item name="colorAccent">@color/ok</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@color/card</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
